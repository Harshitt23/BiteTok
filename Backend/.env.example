# ----------------------------------------------------------------------------
# BiteTok backend environment. Copy to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example for prod: https://bitetok.vercel.app,https://www.bitetok.com
CORS_ORIGIN=http://localhost:5173

# Database — MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/bitetok

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ImageKit media storage (https://imagekit.io)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
